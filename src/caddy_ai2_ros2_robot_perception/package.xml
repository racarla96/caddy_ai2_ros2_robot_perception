<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caddy_ai2_ros2_robot_perception</name>
  <version>0.1.0</version>
  <description>
    Perception stack of the Caddy AI2 on the Jetson Orin NX: u-blox GPS (pending), Helios 3D lidar, VectorNav VN-100 IMU
    and two ZED 2i cameras. Integration package (launch and configuration).
  </description>
  <maintainer email="rafapenya96@gmail.com">Rafael Carbonell Lázaro</maintainer>
  <license>CC-BY-4.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>caddy_ai2_ros2_description</exec_depend>
  <exec_depend>caddy_ai2_ros2_robot_description_publisher</exec_depend>
  <exec_depend>caddy_ai2_ros2_sensors_rs_helios_5515</exec_depend>
  <exec_depend>caddy_ai2_ros2_camera_zed_2i</exec_depend>
  <exec_depend>caddy_ai2_ros2_imu_vectornav_vn100</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
